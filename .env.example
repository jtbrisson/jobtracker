# Copy this file to .env for local development (python-dotenv loads it
# automatically). In Render, set these as real Environment Variables in the
# service's dashboard instead of uploading a .env file.

# --- Core ---
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
# Leave unset locally to use a local SQLite file at instance/jobtracker.db
# On Render this is provided automatically when you attach a Postgres database.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Only these email(s) are allowed to log in (comma-separated, lowercase)
ALLOWED_EMAILS=jtbrisson@gmail.com

# --- File storage: Cloudflare R2 (S3-compatible) ---
# R2 dashboard -> Manage R2 API Tokens to create these.
S3_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
S3_BUCKET_NAME=job-tracker-files
S3_REGION=auto

# --- Benefit year / claim weeks ---
# The Monday your first CA EDD claim week starts (matches the spreadsheet).
BENEFIT_YEAR_START=2025-12-29
BENEFIT_YEAR_WEEKS=53
